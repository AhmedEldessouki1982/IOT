MQTT_URL=mqtt://localhost:1883
HTTP_PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Local Tuya device bridge (optional) ---
# Leave TUYA_DEVICE_ID / TUYA_LOCAL_KEY empty to skip the Tuya bridge
# entirely (TuyaService logs a warning and does not attempt to connect).
TUYA_DEVICE_ID=
TUYA_LOCAL_KEY=
TUYA_DEVICE_IP=
TUYA_PROTOCOL_VERSION=3.3
# Internal device id this Tuya device is known as on
# devices/<id>/state and devices/<id>/cmd MQTT topics.
TUYA_DEVICE_ID_MAPPING=switch1
