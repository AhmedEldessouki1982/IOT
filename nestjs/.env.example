MQTT_URL=mqtt://localhost:1883
HTTP_PORT=3000
CORS_ORIGIN=http://localhost:5173
DATA_DIR=.data

# --- Sonoff T3US3C 3-gang wall switch (flashed Tasmota) ---
# Legacy single-switch topic base. All three POWER relays surface as
# devices sonoff1/sonoff2/sonoff3 for the existing Reception switch.
# Leave SONOFF_BASE empty to disable the bridge entirely, or use the
# multi-switch registry below.
SONOFF_BASE=tasmota_A3AECD
# Device IP — informational only; MQTT control flows through the broker above.
SONOFF_IP=10.0.1.13

# Multi-switch registry. If SONOFF_SWITCHES_JSON or SONOFF_SWITCHES_FILE is set,
# it takes precedence over SONOFF_BASE. Each entry:
# { switchId, base, gangs: 1|2|3, roomType: "toilet"|"bedroom"|"none", roomId }
# Legacy Reception must stay switchId "reception" if you want sonoff1..3 ids.
# New switches use deterministic ids: <switchId>-g<n>.
# SONOFF_SWITCHES_JSON=[{"switchId":"reception","base":"tasmota_A3AECD","gangs":3,"roomType":"none","roomId":"reception"},{"switchId":"toilet-main","base":"tasmota_TOILET","gangs":3,"roomType":"toilet","roomId":"toilet"}]
# SONOFF_SWITCHES_FILE=./sonoff-switches.json
