MQTT_URL=mqtt://localhost:1883
HTTP_PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Sonoff T3US3C 3-gang wall switch (flashed Tasmota) ---
# Topic base the switch reports on. All three POWER relays surface as
# devices sonoff1/sonoff2/sonoff3. Leave SONOFF_BASE empty to disable
# the bridge entirely (SonoffService logs a warning and skips connecting).
SONOFF_BASE=tasmota_A3AECD
# Device IP — informational only; MQTT control flows through the broker above.
SONOFF_IP=10.0.1.13
