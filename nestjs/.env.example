MQTT_URL=mqtt://localhost:1883
HTTP_PORT=3000
CORS_ORIGIN=http://localhost:5173
DATA_DIR=.data

# --- Sonoff T3US3C 3-gang wall switch (flashed Tasmota) ---
# Legacy single-switch topic base. All three POWER relays surface as
# devices sonoff1/sonoff2/sonoff3 for the existing Reception switch.
# Leave SONOFF_BASE empty to disable the bridge entirely, or use the
# multi-switch registry below.
SONOFF_BASE=tasmota_A3AECD
# Device IP — informational only; MQTT control flows through the broker above.
SONOFF_IP=10.0.1.13

# Multi-switch registry. If SONOFF_SWITCHES_JSON or SONOFF_SWITCHES_FILE is set,
# it takes precedence over SONOFF_BASE. Each entry:
# { switchId, base, gangs: 1|2|3, roomType: "toilet"|"bedroom"|"none", roomId,
#   buttonMode: "local" | "detached" }
# buttonMode "local" (Tasmota SetOption73 0): a wall touch toggles its own relay
#   on the device, so the switch keeps working while the backend, broker or
#   network is down; the backend adds the auto-off timer when it is online.
# buttonMode "detached" (the default, Tasmota SetOption73 1): presses are
#   driven by the backend only and do nothing while it is unreachable.
# Legacy Reception must stay switchId "reception" if you want sonoff1..3 ids.
# New switches use deterministic ids: <switchId>-g<n>.
# roomType "none" = a plain on/off switch with NO routine or auto-off timer: the
#   wall buttons and the app just toggle the relays (the master bedroom switch).
# SONOFF_SWITCHES_JSON=[{"switchId":"reception","base":"tasmota_A3AECD","gangs":3,"roomType":"none","roomId":"reception"},{"switchId":"toilet-main","base":"mainToilet","gangs":3,"roomType":"toilet","roomId":"toilet","buttonMode":"local"},{"switchId":"toilet-master","base":"MasterRoomToilet","gangs":3,"roomType":"toilet","roomId":"toilet-master","buttonMode":"local"},{"switchId":"masterRoom","base":"masterRoom","gangs":3,"roomType":"none","roomId":"masterRoom","buttonMode":"local"},{"switchId":"girlRoom","base":"girlRoom","gangs":3,"roomType":"none","roomId":"girlRoom","buttonMode":"local"},{"switchId":"omarRoom","base":"omarRoom","gangs":3,"roomType":"none","roomId":"omarRoom","buttonMode":"local"}]
# SONOFF_SWITCHES_FILE=./sonoff-switches.json
